# ---- Direct Banking environment (copy to .env; never commit real secrets) ----

# --- Local PostgreSQL (docker-compose) ---
# These are SAFE DEVELOPMENT DEFAULTS only. Never use them in production —
# set production credentials in your deployment platform's secret store.
POSTGRES_USER=directbanking
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=direct_banking
POSTGRES_PORT=5432

# PostgreSQL connection string used by Prisma. Must match the values above.
DATABASE_URL="postgresql://directbanking:devpassword@localhost:5432/direct_banking?schema=public"

# HTTP port for the single production Node process
PORT=8080

# Node environment: development | production | test
NODE_ENV=development

# Session/cookie signing secret — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Session lifetime in days
SESSION_TTL_DAYS=7

# Set true only when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=false

# Reminder scheduler poll interval in seconds
SCHEDULER_INTERVAL_SECONDS=60

# Optional SMTP for email reminders. If unset, email reminders are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Direct Banking <no-reply@direct-banking.local>"

# ---- Open Banking (Phase 3) ----
# Leave OPEN_BANKING_ENABLED=false to run the notification-only app normally.
# CI/tests need NONE of these — a fake provider is used. Never commit real secrets.
OPEN_BANKING_ENABLED=false
# plaid (accounts + balances + transactions) | truelayer (account-linking only)
OPEN_BANKING_PROVIDER=plaid
# TrueLayer Data API. Start in sandbox; the client secret is used server-side ONLY.
TRUELAYER_ENV=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
# Must be an HTTPS callback, e.g. https://<host>/api/mobile/v1/bank-connections/callback
TRUELAYER_RETURN_URI=
# 32-byte key (hex or base64) for AES-256-GCM encryption of connection material:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OPEN_BANKING_DATA_KEY=
# Optional scheduled sync cadence (cron expression); manual + on-connect sync work without it.
BANK_SYNC_CRON=

# Plaid (fully transaction-capable provider). Secret is server-side ONLY — never in the APK.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# HTTPS webhook, e.g. https://<host>/api/mobile/v1/bank-connections/webhook
PLAID_WEBHOOK_URI=
