# ---- Direct Banking environment (copy to .env; never commit real secrets) ----

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/direct_banking?schema=public"

# HTTP port for the single production Node process
PORT=8080

# Node environment: development | production | test
NODE_ENV=development

# Session/cookie signing secret — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Session lifetime in days
SESSION_TTL_DAYS=7

# Set true only when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=false

# Reminder scheduler poll interval in seconds
SCHEDULER_INTERVAL_SECONDS=60

# Optional SMTP for email reminders. If unset, email reminders are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Direct Banking <no-reply@direct-banking.local>"
