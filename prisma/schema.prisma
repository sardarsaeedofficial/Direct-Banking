// Direct Banking — Prisma schema
// Money is stored as integer minor units (pence) using BigInt to avoid float drift.
// History is never overwritten: future payments generate idempotently, refunds and
// merchant re-links create NEW rows that link back to the originals.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum AccountType {
  CURRENT
  SAVINGS
  CREDIT_CARD
  LOAN
  CASH
  OTHER
}

enum TxnDirection {
  INCOME
  EXPENSE
  TRANSFER
}

enum TxnStatus {
  PENDING
  COMPLETED
  REFUNDED
  CANCELLED
}

enum TxnSource {
  MANUAL
  CSV_IMPORT
  NOTIFICATION
  OPEN_BANKING
  STATEMENT_IMPORT
}

// Canonical ledger classification for a transaction (Phase 1). Distinct from the
// coarse TxnDirection so the ledger can tell real income/spending apart from
// transfers between the user's own accounts.
enum TxnType {
  INCOME
  PURCHASE
  INTERNAL_TRANSFER
  DIRECT_DEBIT
  STANDING_ORDER
  CASH_WITHDRAWAL
  BANK_FEE
  REFUND
  TRANSFER
  // A repayment of a credit-card balance. Distinct economic type from ordinary
  // spending: the purchases on the card were the real expense, so a repayment
  // must never be double-counted as spending (Financial Event Intelligence).
  CREDIT_CARD_REPAYMENT
  OTHER
}

// How sure we are that a transaction is a transfer between the same user's own
// accounts. Only CONFIRMED/HIGH are treated as internal automatically; POSSIBLE
// is surfaced for the user to confirm.
enum TransferConfidence {
  CONFIRMED
  HIGH
  POSSIBLE
  NOT_INTERNAL
}

// ---------- Phase 2: Direct Debit engine ----------
enum DdStatus {
  ACTIVE
  PAUSED
  CANCELLED
  UNKNOWN
}

enum DdFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  YEARLY
  VARIABLE
}

// How the expected amount is decided. User configuration (FIXED/RANGE) always
// takes precedence over a LEARNED prediction.
enum DdExpectationMode {
  FIXED
  RANGE
  LEARNED
}

// Result of comparing an actual payment to its expectation.
enum DdAnomaly {
  NORMAL
  ABOVE_EXPECTED
  BELOW_EXPECTED
  UNEXPECTED_DATE
  FIRST_PAYMENT
  UNKNOWN
}

// Keeps recurring kinds distinguishable so Phase 4 can add non-DD recurrences
// without mislabelling them all as Direct Debits.
enum RecurringKind {
  DIRECT_DEBIT
  STANDING_ORDER
  SUBSCRIPTION
  RECURRING_CARD
}

// ---------- Phase 3: Open Banking ----------
enum BankConnectionStatus {
  PENDING
  AUTHORIZATION_REQUIRED
  ACTIVE
  REAUTH_REQUIRED
  EXPIRED
  REVOKED
  ERROR
}

// Who owns the truth for an account's balance. Manual accounts are LEDGER
// (balance = opening + credits − debits); Open-Banking-connected accounts are
// PROVIDER (the bank's reported balance is authoritative).
enum BalanceAuthority {
  LEDGER
  PROVIDER
}

enum RecurringType {
  DIRECT_DEBIT
  STANDING_ORDER
  SUBSCRIPTION
  CARD_RECURRING
  RENT
  LOAN
  INSURANCE
  COUNCIL_TAX
  MANUAL
}

enum Frequency {
  WEEKLY
  FORTNIGHTLY
  FOUR_WEEKLY
  MONTHLY
  QUARTERLY
  BIANNUAL
  ANNUAL
  CUSTOM
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum ExpectedStatus {
  PROJECTED
  DUE
  MATCHED
  PAID
  SKIPPED
  OVERDUE
}

enum ReminderChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ReminderStatus {
  SCHEDULED
  SENT
  DISMISSED
  FAILED
}

enum ImportStatus {
  PENDING
  PREVIEW
  COMMITTED
  ROLLED_BACK
  FAILED
}

enum NotifStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

// ---------- Core identity ----------
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  displayName      String?
  baseCurrency     String   @default("GBP")
  locale           String   @default("en-GB")
  // IANA timezone used to compute reporting-period boundaries (Phase 4). Data is
  // always stored in UTC; only period math is done in the user's timezone.
  timezone         String   @default("Europe/London")
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions      Session[]
  accounts      BankAccount[]
  merchants     Merchant[]
  categories    Category[]
  categoryRules CategoryRule[]
  transactions  Transaction[]
  recurring     RecurringPayment[]
  expected      ExpectedPayment[]
  budgets       Budget[]
  reminders     Reminder[]
  importBatches ImportBatch[]
  notifications NotificationImport[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  settings      AppSetting[]
  mobileDevices MobileDevice[]
  mobileTokens  MobileRefreshToken[]
  ddMandates    DirectDebitMandate[]
  bankConnections BankConnection[]
  statementImports StatementImport[]
  transactionCorrections TransactionCorrection[]
  reconciliationDecisions ReconciliationDecision[]
  financialEvents FinancialEvent[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  csrfSecret String
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ---------- Banking domain ----------
model BankAccount {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName     String
  nickname     String
  accountType  AccountType @default(CURRENT)
  lastFour     String?
  currency     String      @default("GBP")
  balanceMinor BigInt      @default(0)
  colour       String      @default("#2563eb")
  icon         String?
  isArchived   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Account-holder identity (Phase 1). Masked forms only — never store full
  // sensitive banking identifiers when a masked representation is sufficient.
  accountHolderName   String?
  sortCodeMasked      String?
  accountNumberMasked String?
  ibanMasked          String?
  providerAccountId   String? // stable id from an Open Banking / statement provider

  // ---- Phase 3: Open Banking linkage ----
  balanceAuthority     BalanceAuthority @default(LEDGER)
  availableBalanceMinor BigInt?
  bankConnectionId     String?
  bankConnection       BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  // Opaque provider ownership key, used internally to strengthen own-account
  // transfer detection (never exposed in full to the client).
  providerOwnershipKey String?

  transactions Transaction[]      @relation("AccountTransactions")
  transfersIn  Transaction[]      @relation("TransferCounterparty")
  recurring    RecurringPayment[]
  expected     ExpectedPayment[]
  ddMandates   DirectDebitMandate[]
  statementImports StatementImport[]

  @@index([userId])
}

model Merchant {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName       String
  normalisedKey     String
  logo              String?
  defaultCategoryId String?
  defaultCategory   Category? @relation(fields: [defaultCategoryId], references: [id])
  createdAt         DateTime @default(now())

  transactions Transaction[]
  recurring    RecurringPayment[]

  @@unique([userId, normalisedKey])
  @@index([userId])
}

model Category {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  // Stable code (e.g. "GROCERIES") so logic never depends on display text (Phase 4).
  code     String?
  isSystem Boolean @default(false) // seeded default vs user-created
  colour   String  @default("#64748b")
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  transactions Transaction[]
  recurring    RecurringPayment[]
  budgets      Budget[]
  merchants    Merchant[]
  rules        CategoryRule[]

  @@unique([userId, name])
  @@index([userId, code])
}

// ---------- Phase 4: categorisation, budgets, insights ----------
enum RuleField {
  MERCHANT
  NORMALIZED_MERCHANT
  DESCRIPTION
  RECIPIENT
  SENDER
  DD_COMPANY
}

enum RuleOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
}

// A user categorisation rule: "if <field> <operator> <value> → category".
model CategoryRule {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field         RuleField
  operator      RuleOperator @default(CONTAINS)
  value         String
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String? // soft reference to a child category
  priority      Int          @default(100)
  enabled       Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, enabled, priority])
}

model Transaction {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     BankAccount  @relation("AccountTransactions", fields: [accountId], references: [id])
  direction   TxnDirection
  status      TxnStatus    @default(COMPLETED)
  source      TxnSource    @default(MANUAL)
  amountMinor BigInt
  currency    String       @default("GBP")
  bookedAt    DateTime
  description String

  // True once this transaction's effect has been applied to BankAccount.balanceMinor.
  // Legacy rows created before the balance-maintenance change stay false, so their
  // balances are never reversed on edit/delete.
  balanceApplied Boolean @default(false)
  notes       String?
  tags        String[]     @default([])

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // transfers between the user's own accounts
  transferAccountId String?
  transferAccount   BankAccount? @relation("TransferCounterparty", fields: [transferAccountId], references: [id])

  // split transactions (parent -> children)
  parentId String?
  parent   Transaction?  @relation("TxnSplit", fields: [parentId], references: [id])
  splits   Transaction[] @relation("TxnSplit")

  // refunds link back to the original
  refundOfId String?
  refundOf   Transaction?  @relation("TxnRefund", fields: [refundOfId], references: [id])
  refunds    Transaction[] @relation("TxnRefund")

  // provenance / dedupe
  expectedPaymentId String?
  expectedPayment   ExpectedPayment? @relation(fields: [expectedPaymentId], references: [id])
  importBatchId     String?
  importBatch       ImportBatch?     @relation(fields: [importBatchId], references: [id])
  dedupeHash        String?

  // ---- Phase 1: rich ledger fields (all additive & nullable) ----
  // Canonical classification, above and beyond the coarse `direction`.
  transactionType TxnType?

  // Counterparties. senderAccountId/recipientAccountId are soft references to the
  // user's own BankAccount when known (no FK — a counterparty may be unknown).
  senderName           String?
  senderBankName       String?
  senderAccountId      String?
  senderAccountHint    String?
  recipientName        String?
  recipientBankName    String?
  recipientAccountId   String?
  recipientAccountHint String?

  // Free-text merchant name (distinct from the normalised Merchant relation).
  merchantName String?

  // Timing beyond the canonical bookedAt.
  occurredAt DateTime?
  settledAt  DateTime?

  // Description/reference/reason surfaced in the detail screen.
  paymentReference String?
  bankDescription  String?
  paymentReason    String?

  // Provenance of a notification/open-banking sourced row.
  sourceBankPackage       String?
  sourceBankTransactionId String?

  // Internal-transfer pairing. Both sides of a detected own-account transfer share
  // the same group id; confidence records how it was decided.
  internalTransferGroupId    String?
  internalTransferConfidence TransferConfidence?

  // Category refinement + safely-redacted original description.
  subcategory            String?
  rawDescriptionRedacted String?

  // ---- Phase 2: Direct Debit / recurring linkage (additive) ----
  // A DD transaction stays a normal ledger row but also belongs to its company's
  // mandate/history.
  directDebitMandateId String?
  directDebitMandate   DirectDebitMandate? @relation(fields: [directDebitMandateId], references: [id])
  recurringPaymentGroupId String?
  recurringConfidence     Float?
  recurringKind           RecurringKind?
  ddAnomaly               DdAnomaly?

  // ---- Phase 3: reconciliation ----
  // A POSSIBLE (not auto-merged) reconciliation match points here for review.
  possibleDuplicateOfId String?
  possibleDuplicateOf   Transaction?  @relation("TxnPossibleDup", fields: [possibleDuplicateOfId], references: [id])
  possibleDuplicates    Transaction[] @relation("TxnPossibleDup")
  evidence              TransactionEvidence[]

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, bookedAt])
  @@index([accountId, bookedAt])
  @@index([merchantId])
  @@index([userId, dedupeHash])
  @@index([directDebitMandateId])
  @@index([userId, internalTransferGroupId])
  @@index([userId, transactionType])
  // Phase 4: fast category/merchant reporting per user over a period.
  @@index([userId, categoryId, bookedAt])
  @@index([userId, merchantId, bookedAt])
}

// A recurring payee/mandate (Phase 2). Owns the payment history, the expected
// amount/date, alert configuration and the learned/user-configured predictions
// for one company on one source account.
model DirectDebitMandate {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id])

  // Identity.
  companyName           String
  normalizedCompanyName String
  merchantAlias         String?
  mandateReference      String?
  providerMandateId     String?

  status      DdStatus      @default(ACTIVE)
  kind        RecurringKind @default(DIRECT_DEBIT)
  frequency   DdFrequency   @default(MONTHLY)

  // Expectation. FIXED/RANGE are user configuration; LEARNED is predicted.
  expectationMode DdExpectationMode @default(LEARNED)
  // System-predicted values (kept even when the user overrides).
  expectedAmountMinor Int?
  expectedMinMinor    Int?
  expectedMaxMinor    Int?
  // User overrides — take precedence over any learned/predicted value.
  userExpectedAmountMinor Int?
  userExpectedMinMinor    Int?
  userExpectedMaxMinor    Int?
  userConfiguredExpectedAmount Boolean @default(false)
  learnFromHistory             Boolean @default(true)

  expectedDayOfMonth Int?
  expectedNextDate   DateTime?
  userExpectedDate   DateTime? // user override for the next expected date
  expectedTime       String?

  alertDaysBefore      Int  @default(3)
  amountTolerancePercent Int  @default(15)
  amountToleranceMinor   Int?

  // Learned observations.
  firstSeenAt   DateTime  @default(now())
  lastPaidAt    DateTime?
  lastAmountMinor Int?
  nextExpectedAt  DateTime?
  paymentCount    Int      @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  // A company appears once per user per source account — subsequent payments
  // append to the same mandate rather than creating a new one each month.
  @@unique([userId, accountId, normalizedCompanyName])
  @@index([userId, status])
  @@index([userId, nextExpectedAt])
}

// A user's Open Banking connection to one institution (Phase 3). Provider tokens
// / connection identifiers are stored ONLY as authenticated-encrypted ciphertext.
// Bank credentials (username/password/PIN) are never requested or stored.
model BankConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider                      String // e.g. "truelayer"
  providerConnectionIdEncrypted String? // AES-GCM ciphertext of provider tokens/ids
  status                        BankConnectionStatus @default(PENDING)

  institutionName       String?
  institutionProviderId String?

  // Provider item identity (e.g. Plaid item_id — an identifier, not a secret) and
  // the persisted incremental-sync cursor (e.g. Plaid /transactions/sync cursor).
  providerItemId String?
  syncCursor     String?

  consentGrantedAt     DateTime?
  consentExpiresAt     DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastErrorAt          DateTime?
  lastErrorCode        String?

  // Short-lived one-time CSRF state for the authorization callback, bound to the
  // user + device + this connection attempt.
  authState          String?  @unique
  authStateExpiresAt DateTime?
  authDeviceId       String?
  historyImportedAt  DateTime?

  accounts BankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  // Phase 6: webhook routing looks a connection up by providerItemId on every
  // inbound bank webhook — this was previously an unindexed full-table scan.
  @@index([providerItemId])
}

// Each way a canonical transaction was observed (Phase 3). One transaction can
// have several evidence rows (a fast notification + an authoritative Open Banking
// record). Unique on the provider transaction id for idempotent imports.
model TransactionEvidence {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  sourceType TxnSource

  provider              String?
  providerConnectionId  String?
  providerAccountId     String?
  providerTransactionId String?

  notificationFingerprint String?

  // ---- Phase 5: statement-import evidence ----
  // A statement row that evidenced this transaction. rowFingerprint is a normalized
  // digest of the row (never the raw statement text) and, with statementImportId,
  // makes re-importing the same file idempotent.
  statementImportId String?
  statementImport   StatementImport? @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  rowFingerprint    String?
  rowIndex          Int?

  observedAt     DateTime @default(now())
  rawPayloadHash String?

  createdAt DateTime @default(now())

  @@unique([provider, providerTransactionId])
  @@unique([statementImportId, rowFingerprint])
  @@index([transactionId])
  @@index([notificationFingerprint])
  @@index([statementImportId])
}

model RecurringPayment {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                RecurringType    @default(DIRECT_DEBIT)
  merchantId          String?
  merchant            Merchant?        @relation(fields: [merchantId], references: [id])
  merchantName        String
  accountId           String
  account             BankAccount      @relation(fields: [accountId], references: [id])
  expectedAmountMinor BigInt
  isVariable          Boolean          @default(false)
  currency            String           @default("GBP")
  frequency           Frequency        @default(MONTHLY)
  dayOfMonth          Int?
  intervalDays        Int?
  nextDueDate         DateTime
  startDate           DateTime
  endDate             DateTime?
  categoryId          String?
  category            Category?        @relation(fields: [categoryId], references: [id])
  reminderDays        Int              @default(5)
  status              RecurringStatus  @default(ACTIVE)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  expected  ExpectedPayment[]
  reminders Reminder[]

  @@index([userId, status])
  @@index([nextDueDate])
}

model ExpectedPayment {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringId         String
  recurring           RecurringPayment @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  accountId           String
  account             BankAccount     @relation(fields: [accountId], references: [id])
  dueDate             DateTime
  expectedAmountMinor BigInt
  status              ExpectedStatus  @default(PROJECTED)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  matchedTransactions Transaction[]
  reminders           Reminder[]

  @@unique([recurringId, dueDate])
  @@index([userId, dueDate])
  @@index([status, dueDate])
}

model Budget {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  categoryId String? // null = overall monthly spending budget
  category   Category?    @relation(fields: [categoryId], references: [id])
  period     BudgetPeriod @default(MONTHLY)
  limitMinor BigInt
  currency   String       @default("GBP")
  startDate  DateTime
  // ---- Phase 4 additions ----
  endDate         DateTime?
  rolloverEnabled Boolean   @default(false)
  enabled         Boolean   @default(true)
  alert50         Boolean   @default(true)
  alert75         Boolean   @default(true)
  alert90         Boolean   @default(true)
  alert100        Boolean   @default(true)
  // Highest threshold already alerted this period (for de-duplicated alerts).
  lastAlertPct       Int?
  lastAlertPeriodKey String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([userId, categoryId])
}

model ImportBatch {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String?
  source         TxnSource    @default(CSV_IMPORT)
  status         ImportStatus @default(PENDING)
  columnMapping  Json?
  rowCount       Int          @default(0)
  importedCount  Int          @default(0)
  duplicateCount Int          @default(0)
  createdAt      DateTime     @default(now())
  committedAt    DateTime?
  rolledBackAt   DateTime?

  transactions Transaction[]

  @@index([userId])
}

model NotificationImport {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourcePackage     String
  title             String
  message           String
  receivedAt        DateTime
  parsedMerchant    String?
  parsedAmountMinor BigInt?
  parsedAccount     String?
  confidence        Float       @default(0)
  sourceHash        String
  status            NotifStatus @default(PENDING)
  createdAt         DateTime    @default(now())

  // ---- Mobile (Android notification import) fields ----
  // The duplicate fingerprint from the device is stored in sourceHash and kept
  // unique per user so a reposted/updated notification never duplicates.
  deviceId              String?
  direction             TxnDirection?     // parsed candidate direction
  currency              String            @default("GBP")
  reviewState           String            @default("DRAFT") // DRAFT | REVIEW_REQUIRED | UNRECOGNISED
  redactedText          String?           // redacted source text (never full notification text)
  approvedTransactionId String?

  @@unique([userId, sourceHash])
  @@index([userId, status])
  @@index([userId, reviewState])
}

// ---------- Mobile authentication (native Android client) ----------
model MobileDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String   // client-generated stable device identifier
  platform   String   @default("android")
  model      String?
  appVersion String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime?

  refreshTokens MobileRefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId])
}

model MobileRefreshToken {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  device       MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique // sha256 of the opaque refresh token — never the token itself
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  rotatedAt    DateTime? // set when this token was used to mint its successor
  revokedAt    DateTime?
  replacedById String? // successor in the rotation chain (for reuse detection)

  @@index([userId])
  @@index([deviceId])
}

model Reminder {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringId       String?
  recurring         RecurringPayment? @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  expectedPaymentId String?
  expectedPayment   ExpectedPayment?  @relation(fields: [expectedPaymentId], references: [id], onDelete: Cascade)
  channel           ReminderChannel   @default(IN_APP)
  status            ReminderStatus    @default(SCHEDULED)
  fireAt            DateTime
  sentAt            DateTime?
  message           String?
  createdAt         DateTime          @default(now())

  @@unique([expectedPaymentId, channel])
  @@index([status, fireAt])
  @@index([userId, status])
}

model Attachment {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  createdAt     DateTime     @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model AppSetting {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ===========================================================================
// Phase 5 — Statement import, reconciliation review & correction audit
// ===========================================================================

enum StatementFileType {
  CSV
  OFX
  QIF
  PDF
}

enum StatementStatus {
  UPLOADED
  PARSED
  REVIEW_REQUIRED
  IMPORTED
  PARTIALLY_IMPORTED
  FAILED
}

// How a parsed statement row related to the existing ledger at import time.
enum StatementCandidateStatus {
  NEW // will create a new canonical transaction
  DUPLICATE // already recorded (exact/strong evidence) — skipped
  REVIEW // a possible match a human should confirm
  MATCHED // enriched an existing transaction with statement evidence
  IMPORTED // committed to the ledger
  EXCLUDED // user removed this row before confirming
}

// A single fallback statement-import session (CSV/OFX/QIF/text-PDF). Raw uploaded
// files are NOT persisted; only normalized candidates + metadata are kept.
model StatementImport {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     BankAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename    String
  fileType    StatementFileType
  fileHash    String // sha256 of the uploaded bytes — for double-import protection
  institution String?
  status      StatementStatus   @default(UPLOADED)

  transactionCount Int @default(0)
  importedCount    Int @default(0)
  duplicateCount   Int @default(0)
  reviewCount      Int @default(0)

  periodStart DateTime?
  periodEnd   DateTime?
  error       String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  candidates StatementCandidate[]
  evidence   TransactionEvidence[]

  @@unique([userId, accountId, fileHash]) // re-uploading the same file to the same account is idempotent
  @@index([userId])
  @@index([userId, accountId])
}

// A normalized statement row, staged before anything touches the ledger. Only
// canonical financial fields are stored — never the raw statement document.
model StatementCandidate {
  id                String                   @id @default(cuid())
  statementImportId String
  statementImport   StatementImport          @relation(fields: [statementImportId], references: [id], onDelete: Cascade)
  userId            String
  rowIndex          Int
  bookedAt          DateTime
  timeText          String? // time-of-day if the statement provided one
  amountMinor       BigInt
  currency          String                   @default("GBP")
  direction         TxnDirection
  description       String
  merchantName      String?
  senderName        String?
  recipientName     String?
  reference         String?
  balanceAfterMinor BigInt?
  fingerprint       String // normalized row digest (idempotency / dedupe)
  reconStatus       StatementCandidateStatus @default(NEW)
  matchedTransactionId String?
  excluded          Boolean                  @default(false)
  createdAt         DateTime                 @default(now())

  @@unique([statementImportId, rowIndex])
  @@index([statementImportId])
  @@index([statementImportId, fingerprint])
}

// A user's explicit "these are NOT the same transaction" decision, so the pair is
// never auto-merged again. The pair is stored ordered (aId <= bId) for symmetric lookup.
enum ReconDecisionKind {
  KEEP_SEPARATE
}

model ReconciliationDecision {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionAId String
  transactionBId String
  decision       ReconDecisionKind @default(KEEP_SEPARATE)
  createdAt      DateTime          @default(now())

  @@unique([userId, transactionAId, transactionBId])
  @@index([userId])
}

// Lightweight, append-only audit of important user corrections. Holds only the
// changed canonical fields — never provider secrets or raw payloads.
enum CorrectionAction {
  CATEGORY_CHANGE
  MERCHANT_CHANGE
  MARK_DIRECT_DEBIT
  UNMARK_DIRECT_DEBIT
  RECURRING_CLASSIFICATION
  INTERNAL_TRANSFER_PAIR
  INTERNAL_TRANSFER_UNPAIR
  DUPLICATE_MERGE
  DUPLICATE_KEEP_SEPARATE
  // A user-confirmed correction of a historically misclassified financial event
  // (e.g. an upcoming/declined notification that was incorrectly posted as a
  // completed transaction before this phase's lifecycle safeguards existed).
  LIFECYCLE_RECLASSIFY
}

model TransactionCorrection {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String? // primary transaction; multi-transaction actions record detail in JSON
  action        CorrectionAction
  beforeJson    Json?
  afterJson     Json?
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
}

// ---------- Financial Event Intelligence ----------
// A semantic layer between raw notification/provider capture and the canonical
// ledger. A trusted source proves WHO sent the notification; it never proves
// money moved, the direction, or that a transaction is complete. Every
// notification/provider signal becomes a FinancialEvent first; only a
// sufficiently certain COMPLETED/postable event may ever create or modify a
// canonical Transaction/balance. See LedgerPostingPolicy in
// services/financial-events/ for the rules that enforce this.

enum FinEventKind {
  CARD_PURCHASE
  BANK_TRANSFER
  DIRECT_DEBIT
  CREDIT_CARD_REPAYMENT
  STANDING_ORDER
  SUBSCRIPTION
  RECURRING_CARD
  CASH_WITHDRAWAL
  FEE
  REFUND
  REVERSAL
  BALANCE_INFORMATION
  NON_FINANCIAL
  UNKNOWN
}

enum FinEventLifecycle {
  UPCOMING
  PENDING
  COMPLETED
  DECLINED
  FAILED
  REVERSED
  CANCELLED
  REFUNDED
  UNKNOWN
}

// Separate from lifecycle: whether actual money has moved yet (NONE for
// UPCOMING/DECLINED/FAILED/CANCELLED, DEBIT/CREDIT once real).
enum MoneyEffect {
  NONE
  DEBIT
  CREDIT
}

// What the event is currently allowed to do to the ledger. Decided exclusively
// by LedgerPostingPolicy — never by a notification parser.
enum LedgerImpact {
  NONE
  POSTED
  PENDING_VISIBLE
  CORRECTED
}

enum PaymentRail {
  DIRECT_DEBIT
  CARD
  TRANSFER
  STANDING_ORDER
  CASH
  OTHER
}

enum FinEventConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model FinancialEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Soft references (no DB-level FK), consistent with Transaction's existing
  // senderAccountId/recipientAccountId pattern: the referenced row may not
  // exist yet (a mandate/transaction created after the event) or may be
  // created by a later reconciliation pass. Ownership is always enforced by
  // application-level userId scoping on every read/write, matching every
  // other model in this schema.
  accountId             String?
  directDebitMandateId  String?
  recurringPaymentId    String?
  linkedTransactionId   String?
  notificationImportId  String?

  sourceType        String // "NOTIFICATION" | "PLAID" | "TRUELAYER" | "STATEMENT" | "MANUAL"
  sourcePackage     String?
  sourceFingerprint String

  eventKind   FinEventKind
  lifecycle   FinEventLifecycle
  paymentRail PaymentRail?

  amountMinor Int?
  currency    String?

  // The direction the event implies once/if money moves — known even for an
  // UPCOMING event ("this will be a debit") while moneyEffect stays NONE.
  expectedDirection TxnDirection?
  moneyEffect       MoneyEffect
  ledgerImpact      LedgerImpact

  expectedAt DateTime?
  occurredAt DateTime?
  settledAt  DateTime?

  merchantName  String?
  senderName    String?
  recipientName String?
  reference     String?

  confidenceScore Float // 0..1, source-trust + semantic-clarity combined
  confidenceLevel FinEventConfidenceLevel
  reasonCode      String? // which rule/parser produced this classification

  // Rules version this event was classified with, so a future rules revision
  // can re-evaluate specific events without reprocessing everything on startup.
  semanticVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency: the same device notification (same fingerprint) always
  // resolves to the same event, never a duplicate, mirroring
  // NotificationImport's userId+sourceHash uniqueness.
  @@unique([userId, sourceFingerprint])
  @@index([userId, lifecycle])
  @@index([userId, eventKind])
  @@index([accountId])
  @@index([directDebitMandateId])
  @@index([linkedTransactionId])
}
